# FinDraft production environment variables
# ==========================================
# Copy sections into Railway / Vercel / Clerk dashboards — never commit real secrets.
# See docs/runbooks/deployment.md for bootstrap steps (migrations, Stripe RLS, S3 lifecycle).
#
# Legend:
#   [REQUIRED]  — app will not work correctly without this in production
#   [RECOMMENDED] — strongly advised for production (observability, billing, etc.)
#   [OPTIONAL]  — feature-specific; safe to omit until you need the feature

# =============================================================================
# BACKEND (Railway — api.yourdomain.com)
# Set these on the FastAPI service. Frontend vars are in the Vercel section below.
# =============================================================================

# --- Core ---

# [REQUIRED] Must be "production" — enforces Clerk webhook signature verification.
APP_ENV=production

# [RECOMMENDED] Shown in logs / error reports.
APP_VERSION=0.1.0

# [REQUIRED] Async SQLAlchemy URL — use the non-superuser findraft role, NOT postgres.
# Superuser bypasses RLS and breaks org isolation. See provision script below.
# Example: postgresql+asyncpg://findraft:PASS@host.railway.internal:5432/railway
DATABASE_URL=postgresql+asyncpg://findraft:PASS@HOST:PORT/DBNAME

# [REQUIRED] Sync URL for app sync paths. Use findraft (same as DATABASE_URL user).
# Alembic reads this via backend/alembic/env.py (falls back to alembic.ini locally).
# For migrations, temporarily override with DATABASE_SUPERUSER_URL (postgres).
DATABASE_URL_SYNC=postgresql://findraft:PASS@HOST:PORT/DBNAME

# [ADMIN ONLY — do not set on the running backend service]
# Railway Postgres default superuser; bootstrap, migrations, role provisioning only.
# DATABASE_SUPERUSER_URL=postgresql://postgres:PASS@HOST:PORT/DBNAME

# [REQUIRED] Exact frontend origin(s), comma-separated — no wildcards (Product Spec §12).
# Include https://app.yourdomain.com and any Vercel preview origins you test against.
CORS_ORIGINS=https://app.yourdomain.com

# --- Auth (Clerk production instance) ---

# [REQUIRED] pk_live_... — RS256 JWT verification (JWKS derived from this if CLERK_JWKS_URL unset).
CLERK_PUBLISHABLE_KEY=pk_live_...

# [REQUIRED] sk_live_... — server-side Clerk API (if used).
CLERK_SECRET_KEY=sk_live_...

# [REQUIRED] whsec_... from Clerk Dashboard → Webhooks → api.yourdomain.com/auth/webhook
# Events: organization.created, organizationMembership.created, organizationMembership.updated
CLERK_WEBHOOK_SECRET=whsec_...

# [OPTIONAL] Override JWKS URL; normally derived from CLERK_PUBLISHABLE_KEY.
# CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json

# --- Trial balance file storage (short-term: Railway volume) ---

# [REQUIRED for persistent uploads] Mount a volume at this path on Railway.
# Without a volume, uploads survive only until the next redeploy.
# TB → S3 migration is a tracked gap (docs/tracked-gaps.md); do not rely on /tmp in prod.
UPLOAD_DIR=/data/uploads

# --- Object storage (exports — Excel/PDF/CSV) ---

# [REQUIRED for exports] S3 or Cloudflare R2 bucket in an EU region.
S3_BUCKET=findraft-uploads-prod

# [REQUIRED for exports]
S3_REGION=eu-west-1

# [REQUIRED for exports] IAM access key (or R2 token mapped to these vars).
AWS_ACCESS_KEY_ID=...

AWS_SECRET_ACCESS_KEY=...

# [OPTIONAL] Set for Cloudflare R2 instead of AWS S3.
# S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com

# [OPTIONAL] Defaults shown; override only if policy changes.
# EXPORT_FILE_TTL_DAYS=30
# EXPORT_SIGNED_URL_TTL_SECONDS=3600

# --- AI (Tier 4 mapping tie-breaker) ---

# [REQUIRED for LLM-assisted mapping] Read directly by the OpenAI SDK (not in Settings).
OPENAI_API_KEY=sk-...

# [OPTIONAL] Model overrides (OpenAI SDK env defaults apply if unset).
# OPENAI_MODEL=gpt-4o
# OPENAI_FALLBACK_MODEL=gpt-4o-mini

# --- Billing (Stripe) ---

# [OPTIONAL until billing is live] All three required together for /webhooks/stripe.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID_STARTER=price_...
# STRIPE_PRICE_ID_PRO=price_...
# STRIPE_PRICE_ID_SCALE=price_...

# --- Observability ---

# [RECOMMENDED]
# SENTRY_DSN=https://...@sentry.io/...

# [OPTIONAL]
# LOGTAIL_TOKEN=...

# [OPTIONAL] Resend — waitlist confirmation emails after POST /waitlist.
# Signup still succeeds if unset or Resend errors. Create a key at https://resend.com
# and set it on the Railway FastAPI service (do not commit the real key).
# RESEND_API_KEY=re_...
# [OPTIONAL] Verified sender once your domain is in Resend (defaults to onboarding@resend.dev).
# RESEND_FROM_EMAIL=Kastree <hello@kastree.ie>
# [OPTIONAL] Founder inbox for new waitlist / user signup alerts (skip if unset).
# FOUNDER_NOTIFICATION_EMAIL=you@example.com

# --- Do NOT set in production ---

# AUTH_JWT_SECRET is for pytest HS256 tokens only — production auth is Clerk RS256.

# [OPTIONAL] Public waitlist POST /waitlist — max submissions per IP per hour (in-memory).
# WAITLIST_RATE_LIMIT_PER_IP_PER_HOUR=10


# =============================================================================
# FRONTEND (Vercel — app.yourdomain.com)
# Set these in Vercel → Project → Settings → Environment Variables (Production).
# =============================================================================

# [REQUIRED] pk_live_... (same Clerk production instance as backend).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...

# [REQUIRED] sk_live_... — Next.js server components / middleware.
CLERK_SECRET_KEY=sk_live_...

# [REQUIRED] Enables ClerkProvider + middleware auth gating. Must be exactly "true".
NEXT_PUBLIC_CLERK_READY=true

# [REQUIRED] Vercel / reverse-proxy hosting.
CLERK_TRUST_HOST=true

# [REQUIRED] Public API origin — browser calls this directly (CORS must allow Vercel origin).
NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com

# [OPTIONAL] Defaults match app routes; override only if URLs change.
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/upload
# NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/upload


# =============================================================================
# ONE-TIME DATABASE SETUP (not env vars — run manually per environment)
# =============================================================================
#
# 1. Superuser bootstrap (before or right after first migration):
#      psql "$DATABASE_SUPERUSER_URL" -f backend/scripts/bootstrap_stripe_rls_lookup.sql
#
# 2. Migrations (superuser URL — release command or Railway shell):
#      DATABASE_URL_SYNC="$DATABASE_SUPERUSER_URL" cd backend && alembic upgrade head
#
# 3. Application role + RLS verification (superuser, after migrations):
#      DATABASE_URL_SYNC="$DATABASE_SUPERUSER_URL" ./backend/scripts/provision_and_verify_findraft_role.sh
#    Then set backend DATABASE_URL / DATABASE_URL_SYNC to the findraft URLs printed.
#
# 4. S3 export lifecycle (once per bucket):
#      cd backend && S3_BUCKET=findraft-uploads-prod python scripts/configure_s3_lifecycle.py
#      aws s3api get-bucket-lifecycle-configuration --bucket findraft-uploads-prod
