# Clerk (required for auth UI + middleware)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Required when the dev server is reached via a reverse proxy (e.g. Cloudflare tunnel)
CLERK_TRUST_HOST=true
# Flip to true only after pasting real Clerk Dashboard keys (enables middleware + ClerkProvider)
NEXT_PUBLIC_CLERK_READY=false

# Clerk hosted pages (optional overrides)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/upload
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/upload

# Backend API — browser calls this origin directly (CORS must allow the frontend origin)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
